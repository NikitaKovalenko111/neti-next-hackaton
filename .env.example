BACKEND_PORT=8080
AI_SERVICE_PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=university
POSTGRES_PORT=5433
BACKEND_POSTGRES_USER=backend_app
BACKEND_POSTGRES_PASSWORD=backend_app
RAG_POSTGRES_USER=rag_app
RAG_POSTGRES_PASSWORD=rag_app

RABBITMQ_USER=university
RABBITMQ_PASSWORD=university
RABBITMQ_PORT=5672
RABBITMQ_CONSOLE_PORT=15672
RABBITMQ_QUEUE=agent_requests
RABBITMQ_RESPONSE_QUEUE=agent_responses

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=images
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://localhost:${MINIO_PORT}

OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_CTX=8192
RETRY_DELAY_SECONDS=5
RESPONSE_CACHE_SIZE=128

